{
  "manifest_version": 3,
  "name": "GhostPrint Browser Companion",
  "version": "1.2.2",
  "description": "Audit selected browser tabs and optionally share foreground website hostnames with GhostPrint.",
  "incognito": "not_allowed",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*", "http://localhost/*"], "js": ["dashboard.js"] }
  ],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html" }
}
