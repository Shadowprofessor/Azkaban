# azkaban-agent configuration. Copy to .env — never commit .env.
# Network binds are hard-wired to 127.0.0.1; these only choose ports.
AZK_PROXY_PORT=8080
AZK_WS_PORT=8787

# Reasoning engine: NVIDIA NIM running Nemotron 3 Ultra 550B-A55B.
# Turns itself ON as soon as NVIDIA_API_KEY is set; AZK_NIM_ENABLED=0 forces it off.
# Get a free prototyping key at https://build.nvidia.com/nvidia/nemotron-3-ultra-550b-a55b
# Sends aggregated metadata and public statute text only, and prints the exact JSON first.
# Verify it with:  azkaban nim-check
AZK_NIM_ENABLED=1
AZK_NIM_URL=https://integrate.api.nvidia.com/v1
AZK_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=

# Local Ollama, used automatically when NIM is unreachable (set to 0 to never fall back).
AZK_NIM_FALLBACK_OLLAMA=1
AZK_OLLAMA_URL=http://127.0.0.1:11434
AZK_OLLAMA_MODEL=qwen2.5:7b

# MaxMind GeoLite2 Country database (offline). Download with a free MaxMind
# account and point this at the .mmdb file.
# Durable flow history, so the website can show past sessions, not only this one.
# Stored in evidence/history.db (gitignored). AZK_HISTORY=0 turns recording off;
# clear it any time with:  python -m azkaban_agent history --forget
AZK_HISTORY=1
AZK_HISTORY_DAYS=30
AZK_HISTORY_REPLAY=500

AZK_GEOIP_DB=azkaban-agent/azkaban_agent/data/GeoLite2-Country.mmdb

# Your own identifiers, hashed at startup for hashed-PII matching.
# Comma-separated. Never sent anywhere.
AZK_KNOWN_EMAILS=
AZK_KNOWN_PHONES=
AZK_KNOWN_ADIDS=

# ---- GhostPrint backend (ghostprint/, port 8765): optional account links and breach scan.
# Account links need an OAuth app you register yourself, with redirect URI
# http://127.0.0.1:8765/ . Leave empty to keep the Link apps buttons explaining this.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Breach scan sends the email you type to haveibeenpwned.com. Off unless you set a key.
HIBP_API_KEY=
