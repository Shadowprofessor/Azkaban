# Keep the index on LF regardless of the checkout platform. Windows checkouts of this
# repo were producing whole-tree CRLF diffs with zero content change.
* text=auto eol=lf

# Binary assets: never touch.
*.onnx   binary
*.mmdb   binary
*.png    binary
*.azk    binary
*.zip    binary

# Windows launchers must keep CRLF on checkout.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
