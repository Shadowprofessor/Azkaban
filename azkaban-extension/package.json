{
  "name": "azkaban-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "package": "bash ../scripts/package-extension.sh",
    "test:score": "node --experimental-strip-types e2e/phase8.mjs",
    "test:alerts": "node --experimental-strip-types e2e/phase9.mjs",
    "test:bridge": "node --experimental-strip-types e2e/phase10.mjs",
    "test:queue": "node --experimental-strip-types e2e/phase12.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^5.9.3",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  }
}
